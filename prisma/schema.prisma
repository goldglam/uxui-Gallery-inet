datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  DESIGNER
  DEVELOPER
  VIEWER
}

enum ProjectStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum TicketType {
  NEW_DESIGN
  DESIGN_SYSTEM_UPDATE
  UX_AUDIT
  REDESIGN
  CONSULTATION
}

enum TicketStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  REVIEW_READY
  COMPLETED
  REJECTED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LogActionType {
  COMMENT
  STATUS_CHANGE
  ASSIGNMENT_CHANGE
  PRIORITY_CHANGE
  ATTACHMENT_UPLOADED
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  ssoProviderId  String?        @unique @map("sso_provider_id")
  email          String         @unique
  name           String
  role           UserRole       @default(VIEWER)
  department     String?
  avatarUrl      String?        @map("avatar_url")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  createdProjects Project[]     @relation("ProjectCreator")
  createdTickets  RequestTicket[] @relation("TicketRequester")
  assignedTickets RequestTicket[] @relation("TicketAssignee")
  commentsLogs    CommentLog[]
  favorites       UserFavorite[]

  @@map("users")
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  title         String
  category      String
  platform      String
  duration      String?
  type          String?
  client        String?
  context       String        @db.Text
  dosDonts      Json?         @default("{\"dos\":[],\"donts\":[]}") @map("dos_donts")
  figmaUrl      String        @map("figma_url")
  status        ProjectStatus @default(DRAFT)
  coverImageUrl String        @map("cover_image_url")
  screens       Json          @default("[]")
  designTokens  Json          @default("{}") @map("design_tokens")
  tags          String[]      @default([])
  viewCount     Int           @default(0) @map("view_count")
  likeCount     Int           @default(0) @map("like_count")
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  creator       User          @relation("ProjectCreator", fields: [createdBy], references: [id])
  favorites     UserFavorite[]
  referencedBy  RequestTicket[]

  @@map("projects")
}

model RequestTicket {
  id                 String         @id @default(uuid()) @db.Uuid
  ticketNo           String         @unique @map("ticket_no")
  requesterId        String         @map("requester_id") @db.Uuid
  type               TicketType     @default(NEW_DESIGN)
  title              String
  description        String         @db.Text
  department         String
  priority           TicketPriority @default(MEDIUM)
  dueDate            DateTime?      @map("due_date") @db.Date
  status             TicketStatus   @default(SUBMITTED)
  assignedTo         String?        @map("assigned_to") @db.Uuid
  referenceProjectId String?        @map("reference_project_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  requester          User           @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee           User?          @relation("TicketAssignee", fields: [assignedTo], references: [id])
  referenceProject   Project?       @relation(fields: [referenceProjectId], references: [id])
  logs               CommentLog[]

  @@map("requests")
}

model CommentLog {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  actionType LogActionType @default(COMMENT) @map("action_type")
  message    String        @db.Text
  metadata   Json?         @default("{}")
  createdAt  DateTime      @default(now()) @map("created_at")

  ticket     RequestTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id])

  @@map("comments_logs")
}

model UserFavorite {
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("user_favorites")
}
